# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin panel passcode (leave empty to claim first-run admin password in UI)
ADMIN_PASSCODE=

# Session signing secret (optional; falls back to runtime ephemeral secret)
SESSION_SECRET=

# Optional Supabase Configuration (leave empty to use local authoritative server store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AdMob Test IDs (Development Only)
VITE_ADMOB_ANDROID_APP_ID="ca-app-pub-3940256099942544~3347511713"
VITE_ADMOB_REWARDED_ID="ca-app-pub-3940256099942544/5224354917"
VITE_ADMOB_INTERSTITIAL_ID="ca-app-pub-3940256099942544/1033173712"

# Feature Flags (Real-world rewards strictly disabled by default)
ENABLE_REAL_WORLD_REWARDS="false"
